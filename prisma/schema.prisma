// Prisma 스키마. 문법 참조: https://pris.ly/d/prisma-schema
//
// 접속 URL은 이 파일에 없다. Prisma 7에서 datasource 블록의 `url`/`directUrl`이
// 사라졌기 때문이다. 대신 두 곳이 각각 들고 있다.
//   - CLI(migrate·db pull·studio) → 루트 `prisma.config.ts`가 DIRECT_URL을 쓴다
//   - 런타임 → `src/prisma/prisma.service.ts`가 DATABASE_URL을 쓴다
//
// Prisma가 관리하는 것은 `public` 스키마뿐이다. Supabase가 만든
// auth·storage·realtime 등은 multiSchema를 켜지 않는 한 diff 대상에서 빠지므로
// 마이그레이션이 그것들을 건드리지 않는다. multiSchema를 켤 일이 생기면
// 그 스키마들이 drop 후보로 올라오는지 반드시 먼저 확인해라.

generator client {
  provider = "prisma-client"

  // 생성물을 `src/` 안에 둔다. `nest build`가 src만 dist로 컴파일하기 때문에
  // 밖에 두면 `npm run start:prod`가 클라이언트를 찾지 못한다.
  output = "../src/generated/prisma"

  // NestJS 10은 CommonJS로 컴파일된다. 기본값(esm)으로 두면 생성물이
  // `import.meta.url`을 써서 tsc가 거부한다.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// enum
//
// 테이블·컬럼·enum 이름은 전부 `@@map`/`@map`으로 snake_case로 내린다. Postgres의
// 관례이고, 인용부호 없이 쓸 수 있어 psql·Supabase 콘솔에서 손으로 조회하기 쉽다.
// ---------------------------------------------------------------------------

/// todo가 한 번만 수행되는지 매일 반복되는지. 리마인드 스캔이 이 값과 `remindAt`으로
/// 대상을 좁히기 때문에 template에 인덱스가 걸려 있다.
enum CompleteType {
  ONCE
  DAILY

  @@map("complete_type")
}

/// todo의 타입. 값은 사용자가 엔티티 정의에 명시한 셋이다.
///   - `GENERAL` 일반. 체크 자체가 완료이고 `targetValue`/`targetUnit`이 null이다
///   - `NUMERIC` 숫자형. 사용자가 정한 목표 수치에 `progressValue`가 도달하는 것이 완료다
///   - `STEPS`   걸음수. 값의 출처가 사용자 입력이 아니라 건강 데이터인 것만 다르다
///
/// **`STEPS` 전용 수치 컬럼이 없는 것은 의도한 것이다.** 타입별 컬럼을 따로 두지 않고
/// `targetValue`/`targetUnit`(과 history의 `progressValue`) 한 쌍으로 통합한다는 사용자
/// 결정이다 — 타입이 늘 때마다 컬럼이 늘고 대부분이 null인 테이블이 되는 것을 피한다.
/// 단위("걸음", "분")는 enum이 아니라 `targetUnit` 문자열이 담는다.
enum TodoType {
  GENERAL
  NUMERIC
  STEPS

  @@map("todo_type")
}

// ---------------------------------------------------------------------------
// 모델
// ---------------------------------------------------------------------------

/// todo의 소유자. `user`는 Postgres 예약어라 테이블명을 `app_user`로 둔다.
///
/// Supabase `auth.users`를 FK로 참조하지 않는다. 그러려면 `multiSchema` 프리뷰가
/// 필요하고, 켜는 순간 auth·storage·realtime 스키마가 diff 대상으로 올라온다
/// (이 파일 헤더의 경고). 인증 수단이 정해지면 이 테이블과 어떻게 잇는지 다시 본다.
model AppUser {
  userId BigInt @id @default(autoincrement()) @map("user_id")

  /// RFC 5321이 정한 경로 상한이 320자다.
  ///
  /// **소문자로 정규화한 값만 저장한다.** Postgres `varchar` 비교는 기본 collation에서
  /// 대소문자를 구분하므로, 정규화하지 않으면 `Foo@x.com`과 `foo@x.com`이 **별개 계정**이
  /// 되고 같은 사람이 두 계정을 갖는다. `citext`로 바꾸지 않은 이유는 Prisma가 그것을
  /// 네이티브 타입으로 지원하지 않아 `Unsupported()`가 되고, 그러면 **유일 식별자인 이
  /// 컬럼을 Prisma로 읽고 쓸 수 없게** 되기 때문이다. 표현식 유니크 인덱스
  /// (`lower(email)`)도 쓰지 않는다 — Prisma가 모르는 인덱스라 `findUnique({ where:
  /// { email } })`가 성립하지 않게 된다. 정규화는 어차피 대소문자만이 아니라 trim까지
  /// 필요하므로 **입력 경계(DTO·Service)의 책임**이다.
  ///
  /// **이 유니크는 soft delete와도 부딪힌다.** 탈퇴(`deletedAt` 설정) 후 같은 이메일로
  /// 재가입하면 `P2002`가 나는데, 조회는 `deletedAt: null`을 걸어 그 행이 코드에서
  /// 보이지 않는다 — "존재하지 않는 유저 때문에 가입이 막히는" 상태가 되고 원인을
  /// 찾으려면 DB를 직접 봐야 한다. 가입 경로는 **soft delete된 행까지 조회해서**
  /// 되살릴지 거절할지 판단해야 한다(`deletedAt: null`을 걸지 않는 예외 자리다).
  email String @unique @db.VarChar(320)

  /// IANA 타임존 이름("Asia/Seoul"). DAILY todo의 `todo_history.historied_on`를 계산하는
  /// 기준이며, 계산은 `src/todos/todo-local-date.ts`가 담당한다.
  ///
  /// **형식은 DB가 보장하지 않는다.** 잘못된 값이 한 번 저장되면 `toLocalDateKey`가
  /// `RangeError`를 던지도록 설계돼 있어(조용히 UTC로 떨어뜨리는 것보다 낫다는 판단)
  /// **그 유저의 모든 날짜 계산이 영구히 실패한다.** 검증은 입력 경계의 책임이고,
  /// `Intl.supportedValuesOf('timeZone')`에 있는 값인지 보는 것이 가장 확실하다.
  ///
  /// **이 값을 바꾸는 것은 지나간 기록에 영향을 준다.** DAILY의 `historied_on`은 이미
  /// 저장된 값이라 소급해 바뀌지 않지만, 앞으로의 "오늘"이 달라진다. ONCE의
  /// `historied_on`은 애초에 이 값을 쓰지 않는다(`TodoHistory.historiedOn` 주석).
  timeZone String @default("Asia/Seoul") @map("time_zone") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  todoTemplates TodoTemplate[]
  todoHistories TodoHistory[]

  @@map("app_user")
}

/// todo의 "정의". 사용자가 todo를 만들면 이 행 하나가 생기고, 실제로 수행한 내역은
/// `TodoHistory`가 날짜별로 따로 보관한다.
///
/// 완료 시각(`completedAt`)은 여기에 두지 않는다. 두면 ONCE todo의 완료 상태가
/// template과 history 두 곳에 생겨 어느 쪽이 진실인지 갈린다 — 완료는 "수행 내역"의
/// 속성이므로 history에만 있다.
model TodoTemplate {
  todoId BigInt @id @default(autoincrement()) @map("todo_id")
  userId BigInt @map("user_id")

  title       String  @db.VarChar(200)
  description String?

  /// **둘 다 생성 뒤에는 수정할 수 없다**(사용자 확정 요구). 막는 이유가 다르다.
  ///   - `todoType` → 히스토리가 생성 시 이 값을 복제하고 이후 수정하지 않는다. 여기서
  ///     타입을 바꾸면 **그 뒤에 생기는 히스토리만 새 타입이 되어 같은 todo의 기록이
  ///     타입별로 갈린다.** 지나간 통계가 어긋나고 `targetValue`·`targetUnit`의 의미도
  ///     함께 달라진다
  ///   - `completeType` → 이미 쌓인 히스토리의 `historiedOn` **파생 규칙이 소급해
  ///     달라진다**(ONCE는 `createdAt`, DAILY는 수행일 기준). 유니크 키의 의미가 바뀐다
  ///
  /// 강제는 `UpdateTodoTemplateInput`의 `Omit`이 한다 — DB 제약이 아니다.
  todoType     TodoType     @map("todo_type")
  completeType CompleteType @map("complete_type")

  /// 리마인드 시각 "HH:mm" (유저 타임존 기준). `Char(5)`가 아닌 이유는 Postgres
  /// `char`가 값을 공백으로 패딩해서 비교·직렬화에서 예상하지 못한 공백이 따라붙기
  /// 때문이다.
  ///
  /// **형식은 DB가 보장하지 않는다.** `"9:5"`·`"25:99"`도 들어간다. 스캔이 문자열
  /// 동등 비교로 대상을 좁히므로 형식이 어긋난 값은 **에러 없이 영원히 알림이 오지
  /// 않는다.** 검증은 이 값을 받는 DTO(`@Matches(/^([01]\d|2[0-3]):[0-5]\d$/)`)의
  /// 책임이고, DTO 계층이 생기는 라운드까지 열려 있다.
  remindAt String? @map("remind_at") @db.VarChar(5)

  /// ONCE todo가 수행돼야 하는 시각. DAILY에는 쓰이지 않는다.
  /// ONCE의 `todo_history.historied_on`가 이 값에서 파생된다(`TodoHistory.historiedOn`).
  shouldDoAt DateTime? @map("should_do_at") @db.Timestamptz(3)

  /// NUMERIC·STEPS 타입의 목표치와 단위. GENERAL 타입에서는 둘 다 null이다.
  /// 타입별로 컬럼을 나누지 않고 이 한 쌍이 전부를 담는다(`TodoType` 주석).
  targetValue Decimal? @map("target_value") @db.Decimal(12, 2)
  targetUnit  String?  @map("target_unit") @db.VarChar(16)

  /// DAILY todo의 활성 기간. `activeUntil`이 null이면 무기한이다. 기간 계산이
  /// 유저 타임존 기준 날짜라서 시각 없는 `date`로 둔다.
  activeFrom  DateTime? @map("active_from") @db.Date
  activeUntil DateTime? @map("active_until") @db.Date

  /// **DAILY 전용** 일시 중지 시각. 활성 기간이 남아 있어도 이 값이 있으면
  /// `findDailyActiveOn`의 목록과 리마인드 대상에서 빠진다.
  ///
  /// **ONCE에는 무의미하다.** `findOnceWithoutCompletedHistory`는 이 컬럼을 보지 않으므로
  /// ONCE template에 값을 넣어도 목록에서 빠지지 않는다 — ONCE에 중지 개념을 두는 것은
  /// 확정된 요구사항에 없고, 그 동작을 `test/todos.e2e-spec.ts`가 못으로 박아 뒀다.
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user      AppUser       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  histories TodoHistory[]

  /// `todoId`가 이미 PK라 논리적으로는 중복이지만, `TodoHistory`가 `(todoId, userId)`
  /// 복합 FK로 이 테이블을 참조하려면 참조 대상에 유니크 제약이 있어야 한다.
  /// 그 FK가 "history의 소유자는 template의 소유자와 같다"를 DB 수준에서 강제한다.
  @@unique([todoId, userId])
  /// 목록 조회 두 곳(`findOnceWithoutCompletedHistory`·`findDailyActiveOn`)이 바로 쓰는
  /// 경로다. 둘 다 `userId`로 좁히고 `deletedAt: null`을 함께 걸기 때문에 두 컬럼을 묶는다.
  ///
  /// **리마인드 스캔용 인덱스는 두지 않는다.** `@@index([completeType, remindAt])`을
  /// 넣을 자리인데, 스캔 코드가 아직 없어 **읽는 쪽이 없는 인덱스에 쓰기 비용만 낸다**
  /// (`todo_history.remindAt` 주석의 판단과 같은 근거다). 게다가 선두 컬럼
  /// `complete_type`의 카디널리티가 2라 형태도 좋지 않고, 실제 스캔은 `deleted_at IS
  /// NULL`·`suspended_at IS NULL`과 활성 기간까지 함께 볼 것이므로 **구성은 스캔 코드와
  /// 같이 정해야 한다.**
  @@index([userId, deletedAt])
  @@map("todo_template")
}

/// todo를 실제로 수행한 내역. 하루에 한 행이며, **완료하거나 진행값을 기록할 때 비로소
/// 생긴다**(lazy). 미리 만들어 두지 않기 때문에 "행이 없다"가 곧 "그날 아무것도 하지
/// 않았다"다.
///
/// 값 컬럼들은 template을 가리키지 않고 **복제한다**. template을 나중에 수정해도 이미
/// 지나간 날의 기록이 소급해 바뀌지 않아야 하기 때문이다.
model TodoHistory {
  todoHistoryId BigInt @id @default(autoincrement()) @map("todo_history_id")
  todoId        BigInt @map("todo_id")

  /// 소유자 비정규화. "이 유저의 특정 날짜 기록 전체"를 template join 없이 읽는다.
  ///
  /// **반드시 template에서 복제한다.** 요청 컨텍스트(로그인 유저)에서 채우지 마라 —
  /// 이 컬럼이 소유자 판정에 쓰이므로 남의 `todoId`로 자기 `userId`를 넣는 요청이
  /// 그대로 통과하면 남의 todo 스냅샷이 내 목록에 섞인다. 아래 복합 FK가 그것을
  /// 막지만, FK는 "값이 일치하는지"만 보고 "어디서 왔는지"는 모른다.
  userId BigInt @map("user_id")

  /// 유저 타임존 기준 날짜 키. UTC가 아니라 유저가 보는 날짜여야 자정 경계가 맞는다.
  /// 값은 반드시 `src/todos/todo-local-date.ts`가 만든 것을 쓴다 — `@db.Date`에 넘긴
  /// `Date`는 어댑터가 UTC 컴포넌트로 직렬화하기 때문이다.
  ///
  /// **무엇을 날짜로 삼는지가 `completeType`에 따라 다르다.** 값은 반드시
  /// `src/todos/todo-local-date.ts`의 `toHistoriedOn` 하나로 만든다.
  ///   - `DAILY` → 수행한 날을 **유저 타임존 기준**으로. 날짜별로 한 행씩 생기고,
  ///     이 값이 곧 유저에게 보여 주는 날짜다
  ///   - `ONCE`  → **template `createdAt`의 UTC 날짜.** 표시용이 아니라 중복 방지 키다
  ///
  /// **ONCE가 `createdAt`만 쓰는 이유.** ONCE 히스토리는 한 건만 생겨야 하는데 DB
  /// 제약은 아래 `@@unique([todoId, historiedOn])` 하나다. 그래서 이 키가 움직이지 않는
  /// 것이 단건성의 유일한 근거이고, 움직일 수 있는 입력을 **전부** 배제해야 한다.
  /// `createdAt`은 `@default(now())`이고 `@updatedAt`이 아니라 절대 변하지 않는다 —
  /// 반면 `shouldDoAt`은 수정 가능하고 `timeZone`은 유저가 언제든 바꾸는 설정이다.
  /// **결과적으로 ONCE 키에는 가변 입력이 하나도 없다.**
  ///
  /// **대가**: ONCE의 이 값은 유저가 보는 날짜와 무관하다. 실질 비용은 없다 — ONCE
  /// 목록은 "완료 히스토리가 있는가"만 보고 **날짜로 필터하지 않으며**, 예정일은
  /// `shouldDoAt`이, 완료 시점은 `completedAt`이 답한다. 다만 **ONCE를 날짜별로 묶어
  /// 보여 주는 데 이 컬럼을 쓰지 마라.**
  historiedOn DateTime @map("historied_on") @db.Date

  title       String  @db.VarChar(200)
  description String?

  /// template에서 복제한다. **생성 뒤에는 수정하지 않는다** — 그날의 기록이
  /// 어떤 타입이었는지가 나중에 바뀌면 지나간 통계가 소급해 달라진다.
  todoType     TodoType     @map("todo_type")
  completeType CompleteType @map("complete_type")

  /// template에서 복제하지만 **이쪽은 생성 뒤에도 수정할 수 있다** — "오늘만 다른
  /// 시각에 알림"을 받는 자리다. 그래서 알림 대상 판정의 진실은 **history가 있으면
  /// history, 없으면 template**이다.
  ///
  /// **그 스캔용 인덱스는 아직 없다.** 오버라이드 스캔은 유저와 무관하게 "특정
  /// `historied_on` + 특정 `remind_at`"을 찾으므로 `@@index([userId, historiedOn])`가
  /// 쓰이지 않아 풀스캔이 된다. 필요한 것은 `@@index([historiedOn, remindAt])`이고,
  /// **스캔 코드가 생기는 라운드에서 함께 넣는다** — 지금 넣으면 아무도 읽지 않는
  /// 인덱스에 쓰기 비용만 낸다.
  remindAt   String?   @map("remind_at") @db.VarChar(5)
  shouldDoAt DateTime? @map("should_do_at") @db.Timestamptz(3)

  targetValue Decimal? @map("target_value") @db.Decimal(12, 2)
  targetUnit  String?  @map("target_unit") @db.VarChar(16)

  /// 그날 실제로 달성한 값. GENERAL 타입에서는 null이다. NUMERIC은 사용자 입력,
  /// STEPS는 건강 데이터가 출처이며 컬럼은 하나를 공유한다.
  progressValue Decimal? @map("progress_value") @db.Decimal(12, 2)

  /// 완료 시각. `isCompleted` 불리언을 따로 두지 않는다 — 두 값이 어긋날 수 있고,
  /// `completedAt IS NOT NULL`이 완료라는 규칙 하나면 충분하다.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// **복합 FK다.** `(todoId, userId)`로 template을 참조해서 "이 기록의 소유자는
  /// template의 소유자와 같다"를 DB가 강제한다. 단일 FK(`todoId`만)로 두면
  /// `user_id`에 남의 유저 ID를 넣어도 제약을 하나도 위반하지 않아, 소유자 판정에
  /// 쓰이는 비정규화 컬럼이 검증 없이 통과한다.
  template TodoTemplate @relation(fields: [todoId, userId], references: [todoId, userId], onDelete: Cascade)
  user     AppUser      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// upsert의 대상 키다. `where: { todoId_historiedOn: { … } }`가 성립하는 근거다.
  /// DAILY의 "날짜별 한 행"과 ONCE의 "todo당 한 행"을 **둘 다** 이 키 하나로 표현한다
  /// — ONCE는 `historiedOn`이 template `createdAt`에서 파생돼 고정되기 때문이다.
  ///
  /// **부분 유니크로 만들지 않는다.** 두 방향 모두 시도할 이유가 있어 보이지만 둘 다
  /// 더 나쁘다.
  ///   - `where: { deletedAt: null }` → 생성되는 복합 유니크 입력 타입에 그 조건이
  ///     들어가지 않아 `upsert`/`findUnique`가 soft delete된 행을 집는다
  ///   - ONCE 전용 `@@unique([todoId], where: { completeType: ONCE })` → Prisma가
  ///     `todoId`를 **단독 유니크로 믿는다.** DAILY는 같은 `todoId`로 여러 행이 있는데
  ///     `findUnique({ where: { todoId } })`가 타입상 성립해 버린다
  ///
  /// soft delete 복구는 `deletedAt`을 null로 되돌리는 update로 처리한다.
  @@unique([todoId, historiedOn])
  /// **DAILY의 날짜별 조회 경로다.** "이 유저의 특정 날짜 기록"을 template join 없이
  /// 읽는다.
  ///
  /// **ONCE는 이 컬럼으로 조회하지 않는다.** ONCE 목록은 `todo_template`을 진입점으로
  /// "완료 히스토리가 없는 것"을 찾고 날짜로 필터하지 않는다 — ONCE의 `historied_on`은
  /// 유저가 보는 날짜가 아니라 중복 방지 키이기 때문이다(`historiedOn` 주석). 그래서 한
  /// 컬럼에 의미가 다른 두 값이 들어가지만, 조회하는 쪽이 갈려 있어 섞이지 않는다.
  @@index([userId, historiedOn])
  @@map("todo_history")
}
