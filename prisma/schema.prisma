// Prisma 스키마. 문법 참조: https://pris.ly/d/prisma-schema
//
// 접속 URL은 이 파일에 없다. Prisma 7에서 datasource 블록의 `url`/`directUrl`이
// 사라졌기 때문이다. 대신 두 곳이 각각 들고 있다.
//   - CLI(migrate·db pull·studio) → 루트 `prisma.config.ts`가 DIRECT_URL을 쓴다
//   - 런타임 → `src/prisma/prisma.service.ts`가 DATABASE_URL을 쓴다
//
// Prisma가 관리하는 것은 `public` 스키마뿐이다. Supabase가 만든
// auth·storage·realtime 등은 multiSchema를 켜지 않는 한 diff 대상에서 빠지므로
// 마이그레이션이 그것들을 건드리지 않는다. multiSchema를 켤 일이 생기면
// 그 스키마들이 drop 후보로 올라오는지 반드시 먼저 확인해라.
//
// ---------------------------------------------------------------------------
// 이 스키마를 처음 읽는다면
// ---------------------------------------------------------------------------
//
// 할 일 하나는 **두 개의 테이블**로 나뉘어 저장된다.
//
//   todoTemplate — 할 일의 정의. "매일 물 2리터 마시기" 같은 내용이 여기 있다.
//                  제목·설명·목표치·알림 시각 등 사용자가 보고 수정하는 것은
//                  전부 이쪽이다. 할 일을 만들면 이 행이 하나 생긴다.
//
//   todoHistory  — 그 할 일을 실제로 수행한 **완료 기록**. 언제 얼마나 했는지만
//                  담고 할 일의 내용은 담지 않는다. 화면에 제목을 보여 주려면
//                  todoTemplate을 함께 읽어야 한다.
//
// 두 테이블을 나눈 이유: 할 일의 정의는 계속 바뀔 수 있지만(제목 수정 등) 이미
// 지나간 날의 기록은 그대로 남아야 한다. 반대로 기록에 내용을 복사해 두면 제목을
// 한 번 고칠 때마다 과거 기록과 현재 정의가 어긋난다. 그래서 **내용은 정의에만,
// 실적은 기록에만** 둔다.
//
// 기록은 **완료하거나 진행값을 입력할 때 비로소 만들어진다.** 미리 만들어 두지
// 않기 때문에 "그날 행이 없다"가 곧 "그날 아무것도 하지 않았다"는 뜻이다.

generator client {
  provider = "prisma-client"

  // 생성물을 `src/` 안에 둔다. `nest build`가 src만 dist로 컴파일하기 때문에
  // 밖에 두면 `npm run start:prod`가 클라이언트를 찾지 못한다.
  output = "../src/generated/prisma"

  // NestJS 10은 CommonJS로 컴파일된다. 기본값(esm)으로 두면 생성물이
  // `import.meta.url`을 써서 tsc가 거부한다.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// enum
//
// 테이블·컬럼·enum 이름은 전부 `@@map`/`@map`으로 snake_case(단어를 밑줄로 잇는
// 표기)로 내린다. Postgres의 관례이고, 인용부호 없이 쓸 수 있어 psql이나 Supabase
// 콘솔에서 손으로 조회하기 쉽다.
// ---------------------------------------------------------------------------

/// 할 일을 한 번만 하는지, 매일 반복하는지.
///
///   ONCE  일회성. 완료할 때까지 계속 목록에 나오고, 완료하면 사라진다.
///         예정일이 지나도 사라지지 않는다
///   DAILY 매일 반복. 어제 안 했더라도 어제는 미완료로 남고 오늘은 오늘대로
///         다시 목록에 나온다 (밀린 일이 쌓이지 않는다)
enum CompleteType {
  ONCE
  DAILY

  @@map("complete_type")
}

/// 할 일을 무엇으로 달성하는가.
///
///   GENERAL 일반. 체크하면 끝이다
///   NUMERIC 숫자형. 사용자가 목표 수치를 정하고 그만큼 채우면 완료다
///   STEPS   걸음수. NUMERIC과 구조가 같고 값의 출처만 다르다 (사용자 입력이
///           아니라 건강 데이터에서 가져온다)
///
/// `STEPS` 전용 컬럼을 따로 두지 않았다. 타입이 늘 때마다 컬럼을 추가하면 대부분이
/// 비어 있는 테이블이 되기 때문이고, 세 타입이 `targetValue`(목표치)와
/// `targetUnit`(단위) 한 쌍을 공유하는 것으로 충분하다. "걸음"·"분" 같은 단위는
/// enum이 아니라 `targetUnit` 문자열이 담는다.
enum TodoType {
  GENERAL
  NUMERIC
  STEPS

  @@map("todo_type")
}

// ---------------------------------------------------------------------------
// 모델
// ---------------------------------------------------------------------------

/// 할 일의 소유자.
///
/// 테이블 이름이 `user`가 아니라 `app_user`인 것은 `user`가 Postgres의 예약어라서
/// 쓸 때마다 인용부호가 필요해지기 때문이다.
///
/// Supabase가 자체적으로 관리하는 `auth.users` 테이블을 참조하지 않는다. 참조하려면
/// Prisma의 `multiSchema` 기능을 켜야 하는데, 켜는 순간 Supabase가 만든 auth·storage
/// 등 여러 스키마가 마이그레이션 비교 대상으로 올라온다(이 파일 맨 위 경고). 인증
/// 수단이 정해지면 이 테이블과 어떻게 이을지 다시 정한다.
model AppUser {
  userId BigInt @id @default(autoincrement()) @map("user_id")

  /// 로그인·식별에 쓰는 이메일. 320자는 이메일 주소의 최대 길이(RFC 5321)다.
  ///
  /// **저장하기 전에 소문자로 바꿔야 한다.** Postgres의 문자열 비교는 대소문자를
  /// 구분하므로 `Foo@x.com`과 `foo@x.com`이 서로 다른 값이 되고, 같은 사람이 계정
  /// 두 개를 갖게 된다.
  ///
  /// 대소문자를 무시하는 `citext` 타입으로 바꾸지 않은 이유: Prisma가 그 타입을
  /// 정식 지원하지 않아 `Unsupported()`로 선언해야 하는데, 그러면 이 컬럼을 Prisma
  /// 코드에서 읽고 쓸 수 없게 된다. 유일 식별자인 컬럼이 그렇게 되면 곤란하다.
  ///
  /// 탈퇴 후 재가입도 걸린다. 탈퇴는 행을 지우지 않고 `deletedAt`에 시각을 적는
  /// 방식(soft delete)인데, 이메일 중복 검사는 그 행까지 포함해서 하므로 같은
  /// 이메일로 다시 가입하면 중복 오류가 난다. 그런데 일반 조회는 `deletedAt`이 비어
  /// 있는 행만 보기 때문에 **화면에는 그 유저가 존재하지 않는 것처럼 보인다.**
  /// 그래서 가입 처리만큼은 탈퇴한 행까지 찾아본 뒤 되살릴지 거절할지 정해야 한다.
  email String @unique @db.VarChar(320)

  /// 이 유저가 사는 지역의 시간대. `Asia/Seoul`처럼 IANA가 정한 이름을 쓴다.
  /// 매일 반복(DAILY) 할 일의 "오늘"이 언제 바뀌는지를 이 값이 정한다.
  ///
  /// **형식이 올바른지 DB가 검사하지 않는다.** 잘못된 값이 한 번 저장되면 날짜
  /// 계산 함수가 예외를 던지도록 만들어 두었기 때문에(조용히 UTC로 처리하면 그
  /// 유저의 날짜가 전부 하루씩 어긋난 채 쌓인다) **그 유저의 모든 날짜 계산이
  /// 계속 실패한다.** 값을 받는 쪽에서 `Intl.supportedValuesOf('timeZone')`에
  /// 들어 있는 이름인지 확인해야 한다.
  ///
  /// 이 값을 나중에 바꾸면 앞으로의 "오늘"만 달라지고 이미 저장된 기록의 날짜는
  /// 그대로 남는다.
  timeZone String @default("Asia/Seoul") @map("time_zone") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// 탈퇴 시각. 값이 있으면 탈퇴한 유저다 (행을 실제로 지우지는 않는다).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  todoTemplates TodoTemplate[]
  todoHistories TodoHistory[]

  @@map("app_user")
}

/// 할 일의 정의. 사용자가 할 일을 만들면 이 행 하나가 생긴다.
///
/// **할 일의 내용은 전부 여기에만 있다.** 제목·설명·목표치·알림 시각을 고치려면
/// 이 행을 수정한다. 완료 기록(`TodoHistory`)에는 내용을 복사하지 않는다.
///
/// 완료 시각을 여기에 두지 않은 이유: 일회성(ONCE) 할 일도 완료 여부는 "수행
/// 기록이 있는가"로 판단한다. 여기에도 완료 시각을 두면 같은 사실이 두 곳에
/// 기록되어 둘이 어긋났을 때 어느 쪽이 맞는지 알 수 없게 된다.
model TodoTemplate {
  todoId BigInt @id @default(autoincrement()) @map("todo_id")
  userId BigInt @map("user_id")

  title       String  @db.VarChar(200)
  description String?

  /// **둘 다 만든 뒤에는 바꿀 수 없다**(사용자 확정 요구). **두 값 모두 완료 기록에
  /// 저장되지 않아서, 이미 쌓인 기록을 해석하는 근거가 이 정의 하나뿐이라는 것이
  /// 공통된 이유다.** 무엇이 어긋나는지가 다르다.
  ///
  /// `todoType`을 바꾸면 — 완료 기록에는 종류가 저장되지 않는다. 그래서 지나간 기록을
  /// 화면에 그릴 때 "이게 무슨 종류의 기록인가"를 판단하는 근거가 이 컬럼 하나뿐이고,
  /// 값을 바꾸면 **이미 쌓인 기록이 전부 새 종류로 다시 해석된다.** 가장 눈에 띄는 것은
  /// 목표치를 쓰는 타입과 쓰지 않는 타입 사이를 오갈 때다 — 숫자형(NUMERIC)에서
  /// 일반(GENERAL)으로 바꾸면 목표치를 가진 과거 기록이 "체크만 하는 할 일"의 기록으로
  /// 표시되고, 반대 방향이면 목표치가 비어 있는 기록에 진행률을 그리려 한다.
  ///
  /// 목표치와 단위 자체는 완료 기록에 함께 복사돼 있어서 흔들리지 않는다(아래
  /// `TodoHistory.targetValue` 참고). 흔들리는 것은 **그 값을 무엇으로 읽을지**다.
  ///
  /// `completeType`을 바꾸면 — 완료 기록의 날짜(`historiedOn`)를 만드는 규칙이
  /// 달라진다. 일회성과 매일 반복이 서로 다른 규칙을 쓰기 때문이다(아래
  /// `TodoHistory.historiedOn` 참고). 게다가 완료 기록에는 이 값이 저장되지 않아
  /// **이미 쌓인 날짜들을 해석할 근거가 이 컬럼 하나뿐이다.** 여기서 바꾸면 과거
  /// 기록의 날짜가 무슨 의미였는지 알아낼 방법이 없어진다.
  ///
  /// 막는 것은 DB 제약이 아니라 TypeScript 타입이다
  /// (`UpdateTodoTemplateInput`에서 두 필드를 제외했다).
  todoType     TodoType     @map("todo_type")
  completeType CompleteType @map("complete_type")

  /// 알림을 보낼 시각. `"09:00"`처럼 시:분 형식이고 유저 타임존 기준이다.
  /// **알림 시각은 이 컬럼 하나로 정해진다** — 날짜별로 다르게 설정하는 기능은 없다.
  ///
  /// 고정 길이 타입(`char(5)`)을 쓰지 않은 이유는 Postgres가 그 타입의 값 뒤를
  /// 공백으로 채워서, 비교하거나 JSON으로 내보낼 때 예상하지 못한 공백이 붙기
  /// 때문이다.
  ///
  /// **형식이 올바른지 DB가 검사하지 않는다.** `"9:5"`나 `"25:99"`도 그대로 저장된다.
  /// 알림 대상을 찾을 때 문자열이 정확히 일치하는지로 비교하므로, 형식이 어긋난 값은
  /// **오류 하나 없이 영영 알림이 가지 않는다.** 값을 받는 쪽에서
  /// `@Matches(/^([01]\d|2[0-3]):[0-5]\d$/)`로 검사해야 한다.
  remindAt String? @map("remind_at") @db.VarChar(5)

  /// 일회성(ONCE) 할 일을 언제까지 해야 하는지. 매일 반복에는 쓰지 않는다.
  ///
  /// 이 값이 지나도 할 일이 목록에서 사라지지 않는다. 완료해야 사라진다.
  shouldDoAt DateTime? @map("should_do_at") @db.Timestamptz(3)

  /// 목표치와 그 단위. 숫자형(NUMERIC)·걸음수(STEPS)에서 쓰고 일반(GENERAL)에서는
  /// 둘 다 비어 있다. 타입별로 컬럼을 나누지 않고 이 한 쌍이 전부를 담는다
  /// (`TodoType` 설명 참고).
  targetValue Decimal? @map("target_value") @db.Decimal(12, 2)
  targetUnit  String?  @map("target_unit") @db.VarChar(16)

  /// 매일 반복(DAILY) 할 일이 활성인 기간. 날짜가 아니라 **순간**이고, 판정은
  /// **반열림 구간**이다 — `activeFrom <= 순간 < activeUntil`(사용자 최종 확정).
  /// 시작 순간은 포함되고 상한 순간은 포함되지 않으며, 비어 있는 쪽은 그쪽 제한이
  /// 없다는 뜻이다.
  ///
  /// 반열림으로 정한 이유: 순간에는 "그날의 끝"이 없다. 상한을 포함으로 두면
  /// "8월 31일까지"를 `2026-08-31T23:59:59.999…`처럼 하루의 마지막 순간으로
  /// 표현해야 하는데 그 값은 정밀도에 따라 달라진다. 미포함 상한이면 다음 날
  /// 자정 하나로 끝나고, 이어지는 두 기간이 겹치지도 비지도 않는다.
  ///
  /// 서버는 이 값에 날짜 의미를 부여하지 않는다 — **시간 해석은 클라이언트의
  /// 몫이라는 전제**(사용자 확정)이고, 활성 판정은 요청 순간과 이 두 값을 그대로
  /// 비교한다. `date`에서 `timestamptz(3)`로 바꾼 것이라 유저 타임존 변환이
  /// 성립한다 — 같은 값 하나가 유저마다 다른 벽시계 시각으로 읽히고, "그 순간에
  /// 활성인가"는 타임존과 무관하게 답이 하나다.
  ///
  /// **뒤집힌·빈 기간은 DB의 CHECK 제약이 막는다**
  /// (`todo_template_active_period_check` — 두 값이 모두 있으면
  /// `active_from < active_until`, 등호 없음). Service의 `assertShape`가 같은
  /// 규칙으로 먼저 400을 던지지만, `updateTodo`의 읽기와 쓰기 사이에 잠금이 없어
  /// 동시 수정의 패자가 검증을 지나 저장할 수 있다 — 그 최종 방어가 이 제약이다.
  /// Prisma가 CHECK를 표현하지 못해 마이그레이션 SQL에 손으로 넣었고
  /// (`20260807162419_active_period_check`), `migrate diff`도 비교하지 않는다.
  activeFrom  DateTime? @map("active_from") @db.Timestamptz(3)
  activeUntil DateTime? @map("active_until") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// 삭제 시각. 값이 있으면 삭제된 할 일이다 (행을 실제로 지우지는 않는다).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user      AppUser       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  histories TodoHistory[]

  /// `todoId`만으로도 행이 하나로 정해지므로 이 조합은 논리적으로 중복이다. 그런데도
  /// 둔 이유는 `TodoHistory`가 `(todoId, userId)` 두 컬럼을 묶어 이 테이블을 참조하기
  /// 때문이다 — Postgres는 그런 참조의 대상 쪽에 같은 조합의 유일 제약을 요구한다.
  /// 그 참조가 "기록의 소유자는 정의의 소유자와 같다"를 DB 수준에서 보장한다.
  @@unique([todoId, userId])
  /// 목록 조회 두 가지가 모두 `userId`로 좁히고 삭제되지 않은 것만 보므로 두 컬럼을
  /// 묶어 둔다.
  ///
  /// **알림 대상을 찾는 용도의 인덱스는 두지 않았다.** 그 기능을 구현하기 전에 미리
  /// 만들면 아무도 읽지 않는 인덱스에 쓰기 비용만 든다. 실제 조회 조건이 정해질 때
  /// (삭제 여부·활성 기간을 함께 볼 것이다) 그에 맞춰 만드는 편이 낫다.
  @@index([userId, deletedAt])
  @@map("todo_template")
}

/// 할 일을 실제로 수행한 **완료 기록**.
///
/// **할 일의 내용은 여기에 없다.** 제목·설명·종류·알림 시각은 전부 `TodoTemplate`에
/// 있고, 이 테이블은 "언제 얼마나 했는가"만 담는다. 화면에 제목을 보여 주려면
/// `todoId`로 정의를 함께 읽어야 한다.
///
/// 행은 **완료하거나 진행값을 입력할 때 비로소 만들어진다.** 미리 만들어 두지 않기
/// 때문에 "그날 행이 없다"가 곧 "그날 아무것도 하지 않았다"는 뜻이다.
model TodoHistory {
  todoHistoryId BigInt @id @default(autoincrement()) @map("todo_history_id")
  todoId        BigInt @map("todo_id")

  /// 소유자. `todoId`로 정의를 따라가면 알 수 있는 값이지만 일부러 여기에도 둔다.
  ///
  /// **이 컬럼을 지우지 마라. 아래 묶은 외래키가 이것 없이는 성립하지 않는다** — 소유자
  /// 일치를 DB가 강제하는 유일한 장치다. 원래는 "정의 테이블을 읽지 않고 유저의 기록을
  /// 바로 조회하려고" 둔 것이기도 했지만, 반복 방식이 기록에서 빠지면서 날짜별 조회가
  /// 정의를 함께 읽게 됐다. **그래서 조회 성능은 더 이상 이 컬럼을 정당화하지 않고,
  /// 외래키가 정당화한다.**
  ///
  /// **이 값을 채울 때는 요청자의 식별자를 쓴다.** 저장 경로(`upsertForHistoriedOn`)가
  /// `(todo_id, user_id)`로 정의를 찾아 **소유자를 검사**하기 때문이다. 요청자를 넣으면
  /// 남의 할 일에 기록을 붙이려는 요청이 그 자리에서 "그런 할 일이 없다"로 걸린다.
  ///
  /// **정의 행에서 읽은 값을 그대로 옮기면 그 검사가 무력화될 수 있다.** 소유자로 좁혀
  /// 읽은 정의라면 그 값이 요청자와 같아 결과가 다르지 않지만, 좁히지 않고 읽은 정의에서
  /// 가져오면 그 정의와 자기 자신을 비교하는 동어반복이 되어 아무것도 거르지 못한다.
  /// 근거와 실패 경로는 `src/todos/todo-histories.repository.ts`의 `TodoHistorySnapshot`
  /// 주석에 있다.
  ///
  /// 아래 복합 외래키가 최후의 방어로 남지만 그것에 기대지 마라 — 위 경로는 그것도
  /// 통과하고, 걸리는 경우에도 나오는 오류는 원인을 알기 어려운 제약 위반 메시지다.
  userId BigInt @map("user_id")

  /// 이 기록이 속한 날짜. 값은 반드시 `src/todos/todo-local-date.ts`의
  /// `toHistoriedOn`으로 만든다.
  ///
  /// **무엇을 날짜로 삼는지가 반복 방식에 따라 다르다.**
  ///
  /// 매일 반복(DAILY)이면 실제로 수행한 날을 유저 타임존 기준으로 적는다. 이 값이
  /// 곧 화면에 보여 주는 날짜다.
  ///
  /// 일회성(ONCE)이면 다르다. ONCE는 완료 기록이 **하나만** 있어야 하는데, DB가 가진
  /// 장치는 아래 `@@unique([todoId, historiedOn])` 하나뿐이다. 즉 날짜가 달라지면
  /// DB는 중복으로 보지 않는다 — 8월 1일에 완료했다가 취소하고 8월 3일에 다시
  /// 완료하면 기록이 둘 남는다. 그래서 이 값을 **절대 바뀌지 않는 것**에서 만들어야
  /// 하고, `TodoTemplate`의 생성 시각(`createdAt`)이 그 조건을 만족한다(한 번 정해지면
  /// 수정되지 않는다). 예정일(`shouldDoAt`)은 사용자가 바꿀 수 있고 타임존도 바꿀 수
  /// 있어서 쓸 수 없다.
  ///
  /// **그 결과 ONCE의 이 값은 화면에 보여 줄 날짜가 아니다.** 중복을 막는 열쇠일
  /// 뿐이다. ONCE의 예정일은 `shouldDoAt`이, 실제 완료 시점은 `completedAt`이 답한다.
  /// 잃는 것이 없는 이유는 ONCE 목록이 날짜로 거르지 않기 때문이다 — "완료 기록이
  /// 있는가"만 본다.
  historiedOn DateTime @map("historied_on") @db.Date

  /// 그날의 목표치와 단위. **`TodoTemplate`에서 복사해 오는 유일한 값이다.**
  ///
  /// 참조하지 않고 복사하는 이유: 목표를 5에서 8로 올리면 5를 채웠던 날의 달성률이
  /// 100%에서 62%로 **소급해서 바뀐다.** 그날 기준의 목표를 함께 남겨 두면 지나간
  /// 기록이 나중 변경에 흔들리지 않는다.
  targetValue Decimal? @map("target_value") @db.Decimal(12, 2)
  targetUnit  String?  @map("target_unit") @db.VarChar(16)

  /// 그날 실제로 달성한 값. 일반(GENERAL) 타입에서는 비어 있다. 숫자형은 사용자
  /// 입력, 걸음수는 건강 데이터가 출처이고 컬럼은 하나를 함께 쓴다.
  progressValue Decimal? @map("progress_value") @db.Decimal(12, 2)

  /// 완료한 시각. **비어 있지 않으면 완료한 것이다.**
  ///
  /// `isCompleted` 같은 참/거짓 컬럼을 따로 두지 않았다. 두 값이 서로 어긋날 수 있고,
  /// "이 값이 비었는지"라는 규칙 하나면 충분하기 때문이다.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// 삭제 시각. 값이 있으면 지워진 기록이다 (행은 남겨 둔다).
  ///
  /// **완료 기록은 개별적으로 지울 수 없다**(사용자 확정 요구). 그래서 이 값이 찍히는
  /// 경우는 **할 일 자체가 지워질 때 하나뿐**이고, 그때 그 할 일의 기록이 한
  /// 트랜잭션에서 함께 표시된다. 되살리는 경로는 없다.
  ///
  /// **완료 취소와 다르다.** 완료를 취소하는 것은 위 `completedAt`을 비우는 수정이고
  /// 행은 그대로 남는다 — 그래서 취소한 뒤 다시 완료할 수 있다. 만약 취소가 삭제였다면
  /// 일회성 할 일은 슬롯이 평생 하나뿐이라 **영영 완료할 수 없는 상태**가 된다.
  ///
  /// 그 대가로 **지워진 할 일에는 새 기록을 만들 수 없다.** 아래 유일 제약이 지워진
  /// 행의 자리를 계속 잡고 있기 때문이고, 저장 경로가 그 경우를 명시적으로 거절한다.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// **두 컬럼을 묶은 외래키다.** `(todoId, userId)`가 `TodoTemplate`의 같은 조합과
  /// 일치해야만 행이 저장된다. 즉 남의 할 일 번호에 자기 유저 번호를 붙인 기록은
  /// 삽입 단계에서 거절된다. `todoId`만 참조하면 `user_id`에 아무 값이나 넣어도 제약을
  /// 어기지 않아, 소유자 판정에 쓰는 값이 검증 없이 통과한다.
  template TodoTemplate @relation(fields: [todoId, userId], references: [todoId, userId], onDelete: Cascade)
  user     AppUser      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// 같은 할 일에 같은 날짜의 기록이 둘 생기지 않게 막는다. 기록을 저장할 때 쓰는
  /// "있으면 수정, 없으면 생성"(upsert) 동작이 이 조합을 기준으로 판단한다.
  ///
  /// 매일 반복의 "하루에 한 행"과 일회성의 "할 일당 한 행"을 **이 하나로 함께**
  /// 표현한다. 일회성은 위 `historiedOn` 설명대로 날짜가 고정되기 때문이다.
  ///
  /// **조건부 유일 제약(특정 조건을 만족하는 행에만 적용되는 제약)을 쓰지 않는다.**
  /// 두 가지를 시도할 만해 보이지만 둘 다 지금보다 나쁘다.
  ///   - "삭제되지 않은 행만" 조건을 걸면 → Prisma가 만들어 주는 조회 타입에 그
  ///     조건이 들어가지 않아, 저장·조회가 삭제된 행을 집어 든다
  ///   - "일회성인 행만" 조건을 걸면 → Prisma가 `todoId` 하나만으로 행이 정해진다고
  ///     믿게 된다. 매일 반복은 같은 `todoId`로 여러 행이 있는데도 단건 조회가
  ///     타입상 허용되어 버린다
  ///
  /// 지운 기록도 이 제약의 대상이라 그 자리를 계속 차지한다. 같은 날짜에 다시 기록할
  /// 수 없다는 뜻이고, 그것을 감수하는 대신 삭제의 의미를 다른 테이블과 똑같이 유지한다.
  @@unique([todoId, historiedOn])
  /// 매일 반복 할 일의 날짜별 조회(`findDailyHistoriesOn`)가 쓰는 경로다. 그 조회는
  /// 반복 방식과 삭제 여부를 보려고 정의 테이블도 함께 읽지만, 먼저 이 인덱스로 유저와
  /// 날짜를 좁힌다.
  ///
  /// 일회성은 이 경로로 조회하지 않는다. 위에서 설명했듯 일회성의 `historiedOn`은
  /// 화면에 보여 줄 날짜가 아니기 때문이고, 그래서 날짜별 조회는 매일 반복만 걸러
  /// 내도록 되어 있다.
  @@index([userId, historiedOn])
  @@map("todo_history")
}
