# 필요한 환경변수 목록. 값은 비워 둔다 — 실제 값은 커밋되지 않는 `.env`에 넣는다.
#
# Supabase 대시보드 > Project Settings > Database > Connection string에서
# 두 URL을 각각 복사한다. `[YOUR-PASSWORD]` 자리에 DB 비밀번호를 넣는다.

# 런타임용. 트랜잭션 모드 풀러(포트 6543). 애플리케이션이 이 값으로 붙는다.
# 없으면 부팅이 실패한다 — src/config/env.validation.ts
DATABASE_URL=

# Prisma CLI용. 세션 모드 풀러(포트 5432). 마이그레이션·db pull·studio가 쓴다.
# 애플리케이션은 읽지 않으므로 런타임 배포 환경에는 없어도 된다.
DIRECT_URL=

# HTTP 리슨 포트. 비워 두면 4080이다.
# 1~65535 범위의 10진수 정수만 받는다 — 그 밖의 값은 부팅을 실패시킨다
# (16진수 `0x10`·지수 `8e3` 표기도 거절한다). src/config/env.validation.ts
# 컨테이너의 EXPOSE·k8s 매니페스트의 containerPort와 같은 값이어야 한다.
PORT=
